datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
}

enum MechanicStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  VEHICLE_RECEIVED
  INSPECTION
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PartStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  NET_BANKING
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(150)
  password     String        @db.VarChar(255)
  phone        String?       @db.VarChar(20)
  role         Role          @default(CUSTOMER)
  address      String?       @db.VarChar(255)
  city         String?       @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  vehicles     Vehicle[]
  appointments Appointment[]
  feedback     Feedback[]

  @@map("users")
  @@index([role])
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  regNumber    String        @unique @map("reg_number") @db.VarChar(30)
  make         String        @db.VarChar(50)
  model        String        @db.VarChar(50)
  variant      String?       @db.VarChar(50)
  year         Int
  fuelType     FuelType      @default(PETROL) @map("fuel_type")
  mileage      Int           @default(0)
  color        String?       @db.VarChar(30)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("vehicles")
  @@index([userId])
  @@index([make, model])
}

model ServiceCenter {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(150)
  code         String        @unique @db.VarChar(30)
  address      String        @db.VarChar(255)
  city         String        @db.VarChar(100)
  state        String        @db.VarChar(100)
  pincode      String        @db.VarChar(20)
  phone        String        @db.VarChar(25)
  email        String        @db.VarChar(150)
  openingHours String        @default("Mon - Sat: 8:00 AM - 7:00 PM") @map("opening_hours") @db.VarChar(100)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  mechanics    Mechanic[]
  appointments Appointment[]

  @@map("service_centers")
  @@index([city])
}

model Service {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(120)
  category       String        @db.VarChar(60)
  description    String        @db.Text
  price          Decimal       @db.Decimal(10, 2)
  estimatedHours Decimal       @map("estimated_hours") @db.Decimal(4, 1)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  appointments   Appointment[]

  @@map("services")
  @@index([category])
}

model Mechanic {
  id              Int            @id @default(autoincrement())
  serviceCenterId Int            @map("service_center_id")
  name            String         @db.VarChar(100)
  employeeId      String         @unique @map("employee_id") @db.VarChar(30)
  phone           String         @db.VarChar(25)
  email           String?        @db.VarChar(150)
  specialization  String         @db.VarChar(100)
  experienceYears Int            @default(3) @map("experience_years")
  status          MechanicStatus @default(AVAILABLE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  serviceCenter   ServiceCenter  @relation(fields: [serviceCenterId], references: [id], onDelete: Restrict)
  serviceRecords  ServiceRecord[]

  @@map("mechanics")
  @@index([serviceCenterId])
  @@index([status])
}

model Appointment {
  id                 Int               @id @default(autoincrement())
  appointmentNumber  String            @unique @map("appointment_number") @db.VarChar(40)
  userId             Int               @map("user_id")
  vehicleId          Int               @map("vehicle_id")
  serviceCenterId    Int               @map("service_center_id")
  serviceId          Int               @map("service_id")
  preferredDate      DateTime          @map("preferred_date") @db.Date
  preferredTimeSlot  String            @map("preferred_time_slot") @db.VarChar(40)
  status             AppointmentStatus @default(PENDING)
  notes              String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceCenter      ServiceCenter     @relation(fields: [serviceCenterId], references: [id], onDelete: Restrict)
  service            Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  
  serviceRecord      ServiceRecord?
  invoice            Invoice?
  feedback           Feedback?

  @@map("appointments")
  @@index([userId])
  @@index([vehicleId])
  @@index([serviceCenterId])
  @@index([serviceId])
  @@index([status])
  @@index([preferredDate])
}

model ServiceRecord {
  id              Int           @id @default(autoincrement())
  appointmentId   Int           @unique @map("appointment_id")
  mechanicId      Int?          @map("mechanic_id")
  inspectionNotes String?       @map("inspection_notes") @db.Text
  workPerformed   String?       @map("work_performed") @db.Text
  currentMileage  Int?          @map("current_mileage")
  status          String        @default("INSPECTION") @db.VarChar(40)
  completionDate  DateTime?     @map("completion_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  mechanic        Mechanic?     @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  serviceParts    ServicePart[]

  @@map("service_records")
  @@index([mechanicId])
}

model Part {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(150)
  partNumber    String        @unique @map("part_number") @db.VarChar(50)
  category      String        @db.VarChar(80)
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  stockQuantity Int           @default(0) @map("stock_quantity")
  minStockLevel Int           @default(5) @map("min_stock_level")
  status        PartStatus    @default(IN_STOCK)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  serviceParts  ServicePart[]

  @@map("parts")
  @@index([category])
  @@index([status])
}

model ServicePart {
  id              Int           @id @default(autoincrement())
  serviceRecordId Int           @map("service_record_id")
  partId          Int           @map("part_id")
  quantity        Int           @default(1)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalCost       Decimal       @map("total_cost") @db.Decimal(10, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  part            Part          @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@map("service_parts")
  @@index([serviceRecordId])
  @@index([partId])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  appointmentId  Int           @unique @map("appointment_id")
  serviceCharges Decimal       @map("service_charges") @db.Decimal(10, 2)
  partsCharges   Decimal       @map("parts_charges") @db.Decimal(10, 2)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxRate        Decimal       @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  dueDate        DateTime?     @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@map("invoices")
  @@index([paymentStatus])
}

model Payment {
  id             Int               @id @default(autoincrement())
  paymentNumber  String            @unique @map("payment_number") @db.VarChar(40)
  invoiceId      Int               @map("invoice_id")
  amount         Decimal           @db.Decimal(10, 2)
  paymentMethod  PaymentMethod     @map("payment_method")
  transactionRef String?           @map("transaction_ref") @db.VarChar(100)
  status         TransactionStatus @default(SUCCESS)
  paidAt         DateTime          @default(now()) @map("paid_at")
  notes          String?           @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([status])
}

model Feedback {
  id             Int         @id @default(autoincrement())
  appointmentId  Int         @unique @map("appointment_id")
  userId         Int         @map("user_id")
  rating         Int         @default(5)
  serviceQuality Int         @default(5) @map("service_quality")
  staffCourtesy  Int         @default(5) @map("staff_courtesy")
  timelyDelivery Int         @default(5) @map("timely_delivery")
  comments       String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
  @@index([userId])
  @@index([rating])
}
